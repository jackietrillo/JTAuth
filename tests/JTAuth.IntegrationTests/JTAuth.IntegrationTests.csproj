<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- Exit code 8 means "zero tests ran": there are no repository tests until Step 3, and they skip
         when no SQL Server is available. -->
    <TestingPlatformCommandLineArguments>$(TestingPlatformCommandLineArguments) --ignore-exit-code 8</TestingPlatformCommandLineArguments>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Testing.Extensions.CodeCoverage" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="Shouldly" />
    <PackageReference Include="xunit.runner.visualstudio" />
    <PackageReference Include="xunit.v3" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\database\JTAuth.Database\JTAuth.Database.csproj" />
    <ProjectReference Include="..\..\JTAuth.Infrastructure\JTAuth.Infrastructure.csproj" />
  </ItemGroup>

</Project>
